---
title: Request a Free Trial
layout: layouts/base.njk
permalink: /join/index.html
---

{% from "components/section-nav.njk" import sectionNav %}

{#
  Variables:
    heroSectionLabel  — section identity label
    heroAccentColor   — cyan (#0891b2) — the Join section colour
    heroSvgPaths      — UserPlus icon paths from icons-sprite.svg #icon-join
    heroTitle         — page title
    heroSubtitle      — intro text
#}
{% set heroSectionLabel = "Join Phoenix" %}
{% set heroAccentColor = "#0891b2" %}
{% set heroSvgPaths = [
  "M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2",
  "M4.5 7a4 4 0 1 0 8 0 4 4 0 1 0-8 0",
  "M20 8v6",
  "M23 11h-6"
] %}
{% set heroTitle = "Request a Free Trial" %}
{% set heroSubtitle = "Come and try us for free — no commitment, no pressure. Fill in the short form and we'll arrange everything." %}

{% include "components/page-hero.njk" %}

{% set sectionPages = [
  { label: "Request a Trial", path: "/join/" },
  { label: "FAQs", path: "/faqs/" },
  { label: "Membership Fees", path: "/membership-fees/" }
] %}

{# ── Pathway cards (inside sidebar layout) ─────────────────────── #}
{% call sectionNav(sectionPages, heroAccentColor, "Join Phoenix", page.url, heroTitle, heroSvgPaths) %}
  <section class="py-12">

    <h2 class="text-primary font-montserrat font-extrabold text-lg mb-1">
      Which programme is right for you?
    </h2>
    <p class="text-primary/50 text-sm font-inter mb-6">
      Not sure? Select "advise me" in the form below — we'll help you choose on the call.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">

      {# ── Learn to Swim card ── #}
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between gap-3 mb-3">
          <p class="text-primary font-montserrat font-extrabold text-base">Learn to Swim</p>
          <span class="shrink-0 px-2.5 py-1 rounded-full text-xs font-inter font-semibold"
            style="background-color: #0891b218; color: #0891b2;">Ages 3–14</span>
        </div>
        <p class="text-primary/60 text-sm leading-relaxed font-inter mb-4">
          Structured lessons through Swim England Stages 1–7. Perfect for beginners and improvers — no experience needed.
        </p>
        <ul class="space-y-1.5">
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #0891b2;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">Your child cannot yet swim confidently</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #0891b2;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">Working through ASA / Swim England stages</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #0891b2;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">You want qualified, small-group teaching</span>
          </li>
        </ul>
      </div>

      {# ── Competitive Squad card ── #}
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm p-6 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between gap-3 mb-3">
          <p class="text-primary font-montserrat font-extrabold text-base">Competitive Squad</p>
          <span class="shrink-0 px-2.5 py-1 rounded-full text-xs font-inter font-semibold"
            style="background-color: #cc1e1e18; color: #cc1e1e;">Ages 8+</span>
        </div>
        <p class="text-primary/60 text-sm leading-relaxed font-inter mb-4">
          Train and race competitively at club, county, and regional level with our dedicated coaching team.
        </p>
        <ul class="space-y-1.5">
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #cc1e1e;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">Can swim 25m in two or more strokes</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #cc1e1e;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">Wants to race, compete, and improve times</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="shrink-0 mt-0.5" width="13" height="13" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="color: #cc1e1e;" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span class="text-primary/65 text-sm font-inter">Can commit to 2–4 sessions per week</span>
          </li>
        </ul>
      </div>

    </div>
  </section>
{% endcall %}

{# ── Form + Info panel (full-width dark section) ─────────────────── #}
<div class="bg-primary py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-14 xl:gap-20 items-start">

      {# ── Form card ────────────────────────────────────────── #}
      <div class="w-full lg:flex-1 min-w-0">
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

          {# Card header strip #}
          <div class="bg-secondary px-8 lg:px-10 py-4 flex items-center gap-3">
            <div class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
              </svg>
            </div>
            <span class="text-white text-sm uppercase tracking-wider font-montserrat font-bold">
              Free trial request
            </span>
          </div>

          <div class="px-8 lg:px-10 py-8 lg:py-10">
            <h2 class="text-primary font-montserrat font-black text-xl lg:text-2xl mb-1">
              Book your free trial
            </h2>
            <p class="text-primary/45 text-sm font-inter mb-7">
              Just a couple of minutes — we'll do the rest.
            </p>

            <form method="POST" action="#" class="space-y-5">

              {# Row 1: Parent + Child name #}
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="parentName"
                    class="block text-primary text-sm font-inter font-semibold mb-1.5">
                    Parent / Guardian name <span class="text-secondary">*</span>
                  </label>
                  <input id="parentName" name="parentName" type="text" required
                    placeholder="Your full name"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all">
                </div>
                <div>
                  <label for="childName"
                    class="block text-primary text-sm font-inter font-semibold mb-1.5">
                    Child's name <span class="text-secondary">*</span>
                  </label>
                  <input id="childName" name="childName" type="text" required
                    placeholder="Child's first name"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all">
                </div>
              </div>

              {# Row 2: Age + Phone #}
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="childAge"
                    class="block text-primary text-sm font-inter font-semibold mb-1.5">
                    Child's age <span class="text-secondary">*</span>
                  </label>
                  <input id="childAge" name="childAge" type="number" required min="3" max="80"
                    placeholder="e.g. 8"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all">
                </div>
                <div>
                  <label for="phone"
                    class="block text-primary text-sm font-inter font-semibold mb-1.5">
                    Phone number
                  </label>
                  <input id="phone" name="phone" type="tel"
                    placeholder="Best number to reach you"
                    class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all">
                </div>
              </div>

              {# Email #}
              <div>
                <label for="email"
                  class="block text-primary text-sm font-inter font-semibold mb-1.5">
                  Email address <span class="text-secondary">*</span>
                </label>
                <input id="email" name="email" type="email" required
                  placeholder="your@email.com"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all">
              </div>

              {# Programme selector #}
              <div>
                <label for="programme"
                  class="block text-primary text-sm font-inter font-semibold mb-1.5">
                  Interested in <span class="text-secondary">*</span>
                </label>
                <select id="programme" name="programme" required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary bg-white font-inter focus:outline-none focus:border-primary transition-all">
                  <option value="" disabled selected>Select a programme…</option>
                  <option value="learn-to-swim">Learn to Swim</option>
                  <option value="competitive-squad">Competitive Squad</option>
                  <option value="advise-me">Not sure — advise me</option>
                </select>
              </div>

              {# Message #}
              <div>
                <label for="message"
                  class="block text-primary text-sm font-inter font-semibold mb-1.5">
                  Anything else we should know?
                </label>
                <textarea id="message" name="message" rows="3"
                  placeholder="Existing ability, medical notes, preferred days or times…"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-primary font-inter placeholder:text-primary/25 focus:outline-none focus:border-primary transition-all resize-none"></textarea>
              </div>

              {# Submit #}
              <button type="submit"
                class="w-full flex items-center justify-center gap-2.5 py-4 bg-secondary hover:bg-red-700 active:bg-red-800 text-white rounded-xl transition-colors font-montserrat font-extrabold text-base">
                Submit trial request
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </button>

              <p class="text-center text-primary/30 text-xs font-inter">
                <span class="text-secondary">*</span> Required &nbsp;·&nbsp; We never share your data with third parties
              </p>

            </form>
          </div>
        </div>
      </div>

      {# ── Right info panel ─────────────────────────────────── #}
      <div class="w-full lg:w-72 xl:w-80 shrink-0">

        <p class="text-secondary text-xs uppercase tracking-widest font-montserrat font-bold mb-3">
          What happens next
        </p>
        <h2 class="text-white font-montserrat font-black text-xl lg:text-2xl mb-9" style="line-height: 1.2;">
          Three simple steps to your trial.
        </h2>

        {# Step list #}
        <div>

          {# Step 1 #}
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-9 h-9 rounded-full bg-secondary text-white flex items-center justify-center shrink-0 font-montserrat font-extrabold text-sm">
                1
              </div>
              <div class="w-px bg-white/10 flex-1 my-1.5 min-h-7"></div>
            </div>
            <div class="pb-6 pt-1 flex-1 min-w-0">
              <p class="text-white font-inter font-bold text-sm mb-1">Fill in the form</p>
              <p class="text-white/50 text-sm font-inter leading-relaxed">Takes two minutes. Tell us about your child and what you're looking for.</p>
            </div>
          </div>

          {# Step 2 #}
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-9 h-9 rounded-full bg-secondary text-white flex items-center justify-center shrink-0 font-montserrat font-extrabold text-sm">
                2
              </div>
              <div class="w-px bg-white/10 flex-1 my-1.5 min-h-7"></div>
            </div>
            <div class="pb-6 pt-1 flex-1 min-w-0">
              <p class="text-white font-inter font-bold text-sm mb-1">We give you a call</p>
              <p class="text-white/50 text-sm font-inter leading-relaxed">Within 2 working days — a friendly chat to discuss your child's needs and find the right fit.</p>
            </div>
          </div>

          {# Step 3 #}
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-9 h-9 rounded-full bg-secondary text-white flex items-center justify-center shrink-0 font-montserrat font-extrabold text-sm">
                3
              </div>
            </div>
            <div class="pb-6 pt-1 flex-1 min-w-0">
              <p class="text-white font-inter font-bold text-sm mb-1">Come for your free trial</p>
              <p class="text-white/50 text-sm font-inter leading-relaxed">Join a session, meet the coaches, see if Phoenix feels right. No commitment, no pressure.</p>
            </div>
          </div>

        </div>

        {# Trust signals #}
        <div class="mt-4 pt-7 border-t border-white/10">
          <ul class="space-y-2.5">
            <li class="flex items-start gap-2.5">
              <svg class="text-emerald-400 shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-white/60 text-sm font-inter">Completely free — no payment, no obligation</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="text-emerald-400 shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-white/60 text-sm font-inter">Suitable for all abilities from age 3</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="text-emerald-400 shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-white/60 text-sm font-inter">Welcoming, friendly club with 50+ members</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="text-emerald-400 shrink-0 mt-0.5" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span class="text-white/60 text-sm font-inter">Swim England affiliated · founded 1980</span>
            </li>
          </ul>
        </div>

        {# Prefer to talk? #}
        <div class="mt-7 rounded-2xl border border-white/10 p-5">
          <p class="text-white font-inter font-bold text-sm mb-4">
            Prefer to talk first?
          </p>
          <div class="space-y-3">
            <a href="tel:+441543000000"
              class="group flex items-center gap-3 text-white/55 hover:text-white transition-colors text-sm font-inter">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-white/15 flex items-center justify-center transition-colors shrink-0">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.69h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10a16 16 0 0 0 6.15 6.15l1.17-1.17a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <span>01543 000 000 <span class="text-white/25 text-xs">(placeholder)</span></span>
            </a>
            <a href="mailto:membership@cannockphoenix.org"
              class="group flex items-center gap-3 text-white/55 hover:text-white transition-colors text-sm font-inter">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-white/15 flex items-center justify-center transition-colors shrink-0">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/>
                </svg>
              </div>
              <span class="break-all">membership@cannockphoenix.org <span class="text-white/25 text-xs">(placeholder)</span></span>
            </a>
            <div class="flex items-center gap-2 text-white/30 text-xs pt-1 font-inter">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              We aim to reply within 2 working days
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
