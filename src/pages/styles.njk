  {# ─── FORM ELEMENTS ────────────────────────────────────────────────── #}
  <div class="flex items-center gap-4 mt-16 mb-8">
    <p class="text-xs font-montserrat font-semibold uppercase tracking-widest text-secondary whitespace-nowrap">Form Elements</p>
    <hr class="flex-1 border-gray-200 m-0">
  </div>

  <form class="space-y-5" onsubmit="return false;">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="s-name" class="block text-sm font-medium mb-1.5">Full name</label>
        <input
          type="text"
          id="s-name"
          name="name"
          placeholder="Jane Smith"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
      </div>
      <div>
        <label for="s-email" class="block text-sm font-medium mb-1.5">Email address</label>
        <input
          type="email"
          id="s-email"
          name="email"
          placeholder="jane@example.com"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="s-password" class="block text-sm font-medium mb-1.5">Password</label>
        <input
          type="password"
          id="s-password"
          name="password"
          placeholder="••••••••"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
      </div>
      <div>
        <label for="s-number" class="block text-sm font-medium mb-1.5">Number</label>
        <input
          type="number"
          id="s-number"
          name="number"
          placeholder="0"
          min="0"
          class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
      </div>
    </div>

    <div>
      <label for="s-select" class="block text-sm font-medium mb-1.5">Select</label>
      <select
        id="s-select"
        name="select"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white">
        <option value="">Choose a squad…</option>
        <option>Learn to Swim</option>
        <option>Junior Squad</option>
        <option>Performance Squad</option>
        <option>Masters</option>
      </select>
    </div>

    <div>
      <label for="s-textarea" class="block text-sm font-medium mb-1.5">Message</label>
      <textarea
        id="s-textarea"
        name="message"
        rows="4"
        placeholder="Tell us a bit about your swimmer…"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-y"></textarea>
    </div>

    <div>
      <label for="s-file" class="block text-sm font-medium mb-1.5">File upload</label>
      <input
        type="file"
        id="s-file"
        name="file"
        class="text-sm text-gray-600 file:mr-3 file:border-0 file:rounded-full file:px-4 file:py-1.5 file:text-xs file:font-semibold file:bg-primary file:text-white hover:file:bg-primary/80 file:cursor-pointer">
    </div>

    <div>
      <p class="text-sm font-medium mb-2">Checkboxes</p>
      <div class="space-y-2">
        <label class="flex items-center gap-2.5 text-sm cursor-pointer">
          <input type="checkbox" name="sessions" value="learn" checked>
          Learn to Swim
        </label>
        <label class="flex items-center gap-2.5 text-sm cursor-pointer">
          <input type="checkbox" name="sessions" value="junior">
          Junior Squad
        </label>
        <label class="flex items-center gap-2.5 text-sm text-gray-400 cursor-not-allowed">
          <input type="checkbox" name="sessions" value="performance" disabled>
          Performance Squad (disabled)
        </label>
      </div>
    </div>

    <div>
      <p class="text-sm font-medium mb-2">Radio buttons</p>
      <div class="space-y-2">
        <label class="flex items-center gap-2.5 text-sm cursor-pointer">
          <input type="radio" name="membership" value="junior" checked>
          Junior (under 18)
        </label>
        <label class="flex items-center gap-2.5 text-sm cursor-pointer">
          <input type="radio" name="membership" value="adult">
          Adult
        </label>
        <label class="flex items-center gap-2.5 text-sm cursor-pointer">
          <input type="radio" name="membership" value="family">
          Family
        </label>
      </div>
    </div>

    <div>
      <label for="s-range" class="block text-sm font-medium mb-1.5">Range: <span id="s-range-val">50</span></label>
      <input
        type="range"
        id="s-range"
        name="range"
        min="0"
        max="100"
        value="50"
        class="w-full"
        oninput="document.getElementById('s-range-val').textContent = this.value">
    </div>

    <div>
      <label for="s-disabled" class="block text-sm font-medium mb-1.5 text-gray-400">Disabled input</label>
      <input
        type="text"
        id="s-disabled"
        name="disabled"
        value="Not editable"
        disabled
        class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm bg-gray-50 text-gray-400 cursor-not-allowed">
    </div>
  </form>

