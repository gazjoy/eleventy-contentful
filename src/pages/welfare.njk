        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <a
        href="mailto:welfare@cannockswimmingclub.org"
        class="text-emerald-300 text-sm font-inter hover:underline underline-offset-2">welfare@cannockswimmingclub.org</a>
